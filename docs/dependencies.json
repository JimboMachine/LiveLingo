  "rules": [
    {"id": "setting", "title": "新增或改一項設定", "guard": "測試會擋：設定沒有預設值、介面用了不存在的設定名稱、說明文字少一種語言。改了之後有沒有真的生效，要自己開起來看。", "steps": [{"nodes": ["config"], "check": "預設值（DEFAULTS），要讓介面能改就加進 EDITABLE"}, {"nodes": ["service"], "check": "update_config 裡的檢查，還有改了之後要馬上做的事"}, {"nodes": ["service"], "check": "匯出、匯入、恢復預設：這一項算不算設定（SETTINGS_SKIP）、恢復預設時要不要留著（RESET_KEEP）；介面改不到的項目要在 _apply_settings 另外檢查"}, {"nodes": ["appjs"], "check": "設定畫面的開關、存好的回饋、畫面有沒有跟著更新"}, {"nodes": ["i18n"], "check": "名稱和說明，五種語言"}, {"nodes": ["overlay", "tray", "window"], "check": "真正讀這項設定的地方"}, {"nodes": ["tests"], "check": "補一個檢查"}]},
    {"id": "text", "title": "新增或改一句文字", "guard": "測試會擋：五種語言的 key 不一致、簡體裡混進繁體字、視窗外的文字表少一種語言。", "steps": [{"nodes": ["i18n"], "check": "五個語言區塊都要有"}, {"nodes": ["tray", "chatpaint", "region", "transcript"], "check": "同一句話如果也出現在系統匣、浮動留言、框選畫面、字幕檔，那裡各有自己的文字表"}, {"nodes": ["appjs"], "check": "用到這個 key 的地方，版面會不會被較長的語言擠壞"}]},
    {"id": "language", "title": "新增一種語言", "guard": "測試會擋：介面語言和翻譯語言不一致、任何一張文字表少這個語言。字型、辨識模型、安裝程式的語言要自己對。", "steps": [{"nodes": ["translate"], "check": "語言清單（LANGS）、翻譯的提示和範例"}, {"nodes": ["config"], "check": "介面語言（UI_LANGS）、第一次開啟時照 Windows 語言挑"}, {"nodes": ["i18n"], "check": "整個語言區塊"}, {"nodes": ["tray", "chatpaint", "region", "transcript"], "check": "各自的文字表和字型"}, {"nodes": ["speech", "service"], "check": "語音辨識認不認得、自動偵測會不會切過去"}, {"nodes": ["ocr", "assets"], "check": "螢幕文字的辨識模型"}, {"nodes": ["iss", "ci"], "check": "安裝程式的語言檔"}, {"nodes": ["tests"], "check": "每種語言都有的檢查"}]},
    {"id": "api", "title": "新增或改一條 API", "guard": "測試會擋：介面呼叫了伺服器沒有的路徑。", "steps": [{"nodes": ["server"], "check": "路徑和參數"}, {"nodes": ["service"], "check": "對應的方法"}, {"nodes": ["appjs"], "check": "呼叫的地方、失敗時顯示什麼"}, {"nodes": ["selftest"], "check": "自我檢查有沒有走到"}]},
    {"id": "event", "title": "改事件或留言的格式", "guard": "測試會擋：背景送出介面沒接的事件、提醒少了文字。欄位改名不會被擋，四個收留言的地方要自己對。", "steps": [{"nodes": ["service"], "check": "送出的事件和欄位"}, {"nodes": ["appjs"], "check": "接事件的地方、對話畫面"}, {"nodes": ["overlay"], "check": "浮動留言"}, {"nodes": ["transcript"], "check": "字幕檔"}, {"nodes": ["tray"], "check": "選單要不要跟著更新"}]},
    {"id": "source", "title": "改三種來源（讀螢幕、聽對方、聽我）", "guard": "只有文字有測試在看。開關狀態有三個地方在顯示，要一起對。", "steps": [{"nodes": ["service"], "check": "開關、忙碌中、錯誤"}, {"nodes": ["appjs"], "check": "來源卡片"}, {"nodes": ["tray"], "check": "系統匣選單"}, {"nodes": ["config"], "check": "下次開啟要不要自動打開"}, {"nodes": ["i18n"], "check": "名稱和錯誤訊息"}]},
    {"id": "overlay", "title": "改浮動留言的長相", "guard": "測試會把留言畫出來比大小。真的蓋在畫面上的樣子要看自動打包附的截圖。", "steps": [{"nodes": ["config"], "check": "浮動留言的設定（overlay_…）"}, {"nodes": ["service", "server"], "check": "檢查允許的值、改了之後馬上重畫、預覽圖"}, {"nodes": ["chatpaint"], "check": "字型、顏色、描邊、換行"}, {"nodes": ["overlay"], "check": "位置、大小、淡出"}, {"nodes": ["appjs", "i18n", "css"], "check": "設定畫面的控制項和預覽"}, {"nodes": ["selftest", "ci"], "check": "截圖"}]},
    {"id": "display", "title": "改顯示方式、位置或螢幕（浮在畫面上、底部字幕條、只在視窗裡）", "guard": "測試會擋：位置算錯、螢幕拔掉沒拉回來、字幕條改到使用者自己的設定、存的版面套不回來。", "steps": [{"nodes": ["config"], "check": "overlay、overlay_form、overlay_monitor、overlay_rect、overlay_layouts；哪些算外觀（OVERLAY_LOOK）"}, {"nodes": ["overlay"], "check": "現在該在哪（_home）、字幕條固定的排法（BAR_LOOK）、拉回畫面、一鍵版面和自己存的版面"}, {"nodes": ["oswin"], "check": "接著哪些螢幕"}, {"nodes": ["service", "server"], "check": "允許的值、/api/overlay 和 /api/screens、預覽圖也要照字幕條的排法"}, {"nodes": ["tray"], "check": "系統匣的開關改的是 overlay"}, {"nodes": ["appjs", "i18n", "css"], "check": "三張卡片、縮小的螢幕圖（拖的時候不能重畫整頁）、版面清單"}, {"nodes": ["tests"], "check": "顯示方式的檢查"}]},
    {"id": "brand", "title": "換標誌或品牌色", "guard": "測試會擋：圖示檔不見、打包設定沒指到。每個地方的標誌長得一不一樣，要自己看。", "steps": [{"nodes": ["brand"], "check": "介面裡的標誌，還有三個圖示檔"}, {"nodes": ["css", "html"], "check": "標誌的樣式、開場畫面"}, {"nodes": ["tray"], "check": "系統匣圖示"}, {"nodes": ["spec", "iss"], "check": "程式圖示、安裝程式圖示"}, {"nodes": ["window"], "check": "標題列顏色"}]},
    {"id": "theme", "title": "改主題或顏色", "guard": "測試會擋：強調色少了樣式。標題列的顏色要看 Windows 上的截圖。", "steps": [{"nodes": ["css"], "check": "深色、淺色、每種強調色"}, {"nodes": ["appjs"], "check": "主題選單、送給標題列的顏色"}, {"nodes": ["window", "oswin"], "check": "標題列"}, {"nodes": ["config", "service"], "check": "允許的主題和強調色"}, {"nodes": ["selftest"], "check": "深色和淺色的截圖"}]},
    {"id": "package", "title": "新增一個 Python 套件", "guard": "測試會擋：打包設定沒點名執行時才載入的套件。自動打包裡「檢查」那一段的套件清單是手寫的，要自己補。", "steps": [{"nodes": ["req"], "check": "套件和版本"}, {"nodes": ["spec"], "check": "執行時才載入的要點名，會讀自己資料夾的要整包帶走"}, {"nodes": ["ci"], "check": "檢查那一段的手寫清單"}, {"nodes": ["selftest"], "check": "打包後真的載得到；跟電腦環境有關的列為只記錄"}, {"nodes": ["service"], "check": "載不到的時候程式照常能用"}]},
    {"id": "release", "title": "改版本號或發佈", "guard": "測試會擋：更新程式下載的檔名和發佈的檔名不一樣。自動打包會真的安裝、更新、卸載一次。", "steps": [{"nodes": ["ver"], "check": "版本號"}, {"nodes": ["ci"], "check": "讀版本、推到 main 就發佈"}, {"nodes": ["iss"], "check": "安裝檔的版本和檔名"}, {"nodes": ["upd"], "check": "比較版本、下載、靜默安裝"}, {"nodes": ["changes"], "check": "data/changes.json 要有新版本那一段，五種語言、句數一樣；更新提示、關於頁、GitHub 發行說明都讀它"}, {"nodes": ["upd", "service"], "check": "回上一版：update.json 記「從哪一版來的」，留著的安裝檔要核對雜湊才用；新版加了舊版不認得的東西（像搬過位置的大檔案），退回之前要先處理（STORE_BEFORE）"}, {"nodes": ["iss"], "check": "[Files] 要有 ignoreversion，裝舊版才換得掉新版的檔案"}]},
    {"id": "uifile", "title": "新增一個介面檔案", "guard": "測試會擋：畫面載入的檔案不存在、自我檢查沒看、載入順序錯。", "steps": [{"nodes": ["html"], "check": "載入順序"}, {"nodes": ["server"], "check": "有沒有送得出去"}, {"nodes": ["selftest"], "check": "檔案清單"}, {"nodes": ["spec"], "check": "整個 ui 資料夾會一起打包，不用改"}]},
    {"id": "model", "title": "換模型或下載來源", "guard": "測試會看模式的選法和引擎檔案的挑法。真的下載只在自動打包的自我檢查裡跑。", "steps": [{"nodes": ["assets"], "check": "檔案清單、大小、網址"}, {"nodes": ["gpu"], "check": "哪種顯示卡用哪個模型"}, {"nodes": ["service"], "check": "準備流程、缺什麼、退回標準模式"}, {"nodes": ["engine", "ocr", "speech"], "check": "各自去哪裡找檔案"}, {"nodes": ["appjs", "i18n"], "check": "第一次開啟的下載畫面"}]},
    {"id": "audio", "title": "改收音或語音辨識", "guard": "測試用假的音訊裝置。真的麥克風和喇叭只能在你的電腦上確認。", "steps": [{"nodes": ["audio"], "check": "裝置、兩種收音方式"}, {"nodes": ["speech"], "check": "斷句、辨識、選語言"}, {"nodes": ["meters"], "check": "音量"}, {"nodes": ["service"], "check": "找麥克風、自動偵測語言"}, {"nodes": ["appjs"], "check": "音量條、錯誤訊息"}, {"nodes": ["tests"], "check": "假裝置的檢查"}]},
    {"id": "window", "title": "改視窗行為", "guard": "只能靠 Windows 上的自我檢查和截圖。", "steps": [{"nodes": ["window"], "check": "大小、置頂、關閉"}, {"nodes": ["oswin"], "check": "Windows 功能"}, {"nodes": ["config"], "check": "記住的視窗設定"}, {"nodes": ["tray"], "check": "關掉視窗後還在不在"}, {"nodes": ["appjs"], "check": "切換畫面模式"}, {"nodes": ["selftest"], "check": "視窗截圖"}]},
    {"id": "health", "title": "改健康檢查，或是新增一個會出狀況的地方", "guard": "測試會擋：健康檢查的代碼少了哪一種語言的說明。新的功能如果有「開不起來」「被擋住」這種狀態，要記得在健康檢查加一個燈或併進現有的燈。", "steps": [{"nodes": ["service"], "check": "health()：每一項怎麼判斷綠、黃、紅、灰"}, {"nodes": ["i18n"], "check": "每個代碼一句話（h_代碼），五種語言"}, {"nodes": ["appjs"], "check": "健康檢查頁、狀態變了自動重查"}, {"nodes": ["audio", "hotkeys", "watcher", "engine", "gpu", "config", "history"], "check": "各自的狀態是從哪裡來的"}, {"nodes": ["tests"], "check": "各種狀況的檢查"}]},
    {"id": "history", "title": "改對話歷史", "guard": "測試會擋：關掉保存還在記、過期的沒刪、清除之後檔案還在、五種語言的標題。留言多一個欄位時，歷史、字幕記錄、匯出的文字三邊要一起看。", "steps": [{"nodes": ["history"], "check": "記哪些欄位、檔案格式、保留幾天"}, {"nodes": ["service"], "check": "哪一刻算翻好了要記、訊息被拿掉時一起拿掉"}, {"nodes": ["config"], "check": "history_keep、history_days"}, {"nodes": ["transcript"], "check": "匯出的文字長得要一樣"}, {"nodes": ["appjs"], "check": "歷史頁的清單、搜尋、匯出、清除前的確認"}, {"nodes": ["i18n"], "check": "歷史頁的文字"}, {"nodes": ["tests"], "check": "歷史的檢查"}]},
